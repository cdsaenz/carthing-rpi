# Spotify app credentials (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional — only needed if your raspotify device name isn't the default
# "raspotify(<hostname>)" pattern
SPOTIFY_DEVICE_NAME=

# Logitech Media Server
LMS_SERVER_IP=192.168.1.211
LMS_PLAYER_NAME=rpi3b

# Weather — hits your own personal weather API (providers/weather.py), not
# a third-party service; point this at whatever you run, or swap the
# provider for one that fits your setup
API_KEY=
